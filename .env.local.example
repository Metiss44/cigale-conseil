# Postmark Configuration
# Ces variables doivent être configurées dans Vercel (ou votre hébergeur)
# Ne jamais commiter les vraies valeurs dans Git

# Token Serveur API Postmark
POSTMARK_SERVER_TOKEN=

# Adresse email de l'expéditeur (doit être vérifiée dans Postmark - Sender Signatures)
POSTMARK_FROM_EMAIL=

# Adresse email du destinataire (où les messages du formulaire seront envoyés)
POSTMARK_TO_EMAIL=
